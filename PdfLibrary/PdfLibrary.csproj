<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- NuGet Package Metadata -->
        <PackageId>Lxman.PdfLibrary</PackageId>
        <Title>PdfLibrary</Title>
        <Version>2.6.1</Version>
        <Authors>Michael Jordan</Authors>
        <Description>A comprehensive .NET library for parsing, rendering, creating, editing, optimizing, and validating PDF documents. Pure C# implementation with no native or third-party codec dependencies; cross-platform on .NET 8, 9, and 10. Supports PDF 1.x and 2.0, and includes a read-only conformance preflight for PDF/A (2b/2u/3b), PDF/X-4, and PDF/UA-1.</Description>
        <PackageTags>pdf;pdf-reader;pdf-writer;pdf-renderer;pdf-editor;document;csharp;cross-platform;pure-csharp;managed;pdf2.0;pdfa;pdfx;pdf-ua;conformance;preflight;validation;accessibility</PackageTags>
        <PackageReleaseNotes>2.6.1 repairs malformed classic cross-reference tables, restores spaces implied by large TJ positioning gaps, and adds ExtractTextWithQuality() so callers can detect garbled Latin text layers and route them to OCR. See CHANGELOG.md.</PackageReleaseNotes>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/lxman/PdfLibrary</PackageProjectUrl>
        <RepositoryUrl>https://github.com/lxman/PdfLibrary</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>

        <!-- SourceLink + symbol packages: let consumers step into library source while debugging. -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

        <!-- Generate documentation XML for IntelliSense -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS1591: XML docs are not required on every public member -->
        <!-- The public surface is a checked-in file (Docs/superpowers/specs/2026-09-06-release-2-6-0-design.md, D9).
             RS0016: a public symbol is missing from PublicAPI.*.txt. RS0017: the file names a symbol that no
             longer exists. Both are errors: adding public API is a reviewed text-file diff, never an accident.
             RS0026/RS0027 (overload-shape rules) are suppressed: they would require changing shipped
             signatures, and the API files are the contract. -->
        <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
        <NoWarn>$(NoWarn);CS1591;RS0026;RS0027</NoWarn>

        <!-- This package bundles its internal project-reference DLLs into lib/<tfm> (see the
             CopyProjectReferencesToPackage target) so it ships as ONE self-contained package
             instead of depending on internal libraries that are not published to NuGet. -->
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <!-- Bundled default CMYK ICC profile: SWOP TR003 Coated, CC0-1.0 (+NPES attribution),
             shipped verbatim. The library carries no Adobe IP; consumers needing Adobe SWOP
             supply it via CmykProfileProvider.OverrideProfileBytes. -->
        <EmbeddedResource Include="Rendering\Icc\Profiles\SWOP_TR003_coated_3.icc">
            <LogicalName>PdfLibrary.Rendering.Icc.Profiles.SWOP_TR003_coated_3.icc</LogicalName>
        </EmbeddedResource>
        <None Include="Rendering\Icc\Profiles\NOTICE-cmyk-profile.txt" Pack="true" PackagePath="licenses\" />
    </ItemGroup>

    <ItemGroup>
        <!-- Adobe CID→Unicode CMaps (B-1 text extraction): the four Adobe-<Ordering>-UCS2 CMaps from
             github.com/adobe-type-tools/mapping-resources-pdf, BSD-3-Clause (license bundled alongside),
             gzip-compressed. Loaded lazily by AdobeCidToUnicode. -->
        <EmbeddedResource Include="Resources\CMaps\Adobe-Japan1-UCS2.gz">
            <LogicalName>PdfLibrary.Resources.CMaps.Adobe-Japan1-UCS2.gz</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Resources\CMaps\Adobe-Korea1-UCS2.gz">
            <LogicalName>PdfLibrary.Resources.CMaps.Adobe-Korea1-UCS2.gz</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Resources\CMaps\Adobe-GB1-UCS2.gz">
            <LogicalName>PdfLibrary.Resources.CMaps.Adobe-GB1-UCS2.gz</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Resources\CMaps\Adobe-CNS1-UCS2.gz">
            <LogicalName>PdfLibrary.Resources.CMaps.Adobe-CNS1-UCS2.gz</LogicalName>
        </EmbeddedResource>
        <None Include="Resources\CMaps\LICENSE-Adobe-CMaps.txt" Pack="true" PackagePath="licenses\" />
    </ItemGroup>

    <ItemGroup>
        <!-- Adobe Core-14 AFM metrics (L4 font remediation): the eight vendored Core-14 faces from
             Adobe's APAFML-licensed AFM files (license bundled alongside), gzip-compressed, shipped
             verbatim. Loaded lazily by Standard14Metrics. -->
        <EmbeddedResource Include="Resources\Afm\Helvetica.afm.gz">
            <LogicalName>PdfLibrary.Resources.Afm.Helvetica.afm.gz</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Resources\Afm\Helvetica-Bold.afm.gz">
            <LogicalName>PdfLibrary.Resources.Afm.Helvetica-Bold.afm.gz</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Resources\Afm\Times-Roman.afm.gz">
            <LogicalName>PdfLibrary.Resources.Afm.Times-Roman.afm.gz</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Resources\Afm\Times-Bold.afm.gz">
            <LogicalName>PdfLibrary.Resources.Afm.Times-Bold.afm.gz</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Resources\Afm\Times-Italic.afm.gz">
            <LogicalName>PdfLibrary.Resources.Afm.Times-Italic.afm.gz</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Resources\Afm\Times-BoldItalic.afm.gz">
            <LogicalName>PdfLibrary.Resources.Afm.Times-BoldItalic.afm.gz</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Resources\Afm\Symbol.afm.gz">
            <LogicalName>PdfLibrary.Resources.Afm.Symbol.afm.gz</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Resources\Afm\ZapfDingbats.afm.gz">
            <LogicalName>PdfLibrary.Resources.Afm.ZapfDingbats.afm.gz</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Resources\Afm\LICENSE-Adobe-Core14-AFM.txt">
            <LogicalName>PdfLibrary.Resources.Afm.LICENSE-Adobe-Core14-AFM.txt</LogicalName>
        </EmbeddedResource>
        <None Include="Resources\Afm\LICENSE-Adobe-Core14-AFM.txt" Pack="true" PackagePath="licenses\" />
    </ItemGroup>

    <ItemGroup>
        <!-- Adobe Glyph List (issue 27-28 Task 10): the canonical glyphlist.txt from
             github.com/adobe-type-tools/agl-aglfn, BSD-3-Clause (license + pinned-commit SHA256
             recorded alongside), shipped verbatim, uncompressed. Parsed lazily by GlyphList
             AFTER its hand-built entries, so only names absent from the hand table are added. -->
        <EmbeddedResource Include="Resources\Agl\glyphlist.txt">
            <LogicalName>PdfLibrary.Resources.Agl.glyphlist.txt</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Resources\Agl\LICENSE.md">
            <LogicalName>PdfLibrary.Resources.Agl.LICENSE.md</LogicalName>
        </EmbeddedResource>
        <None Include="Resources\Agl\LICENSE.md" Pack="true" PackagePath="licenses\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <!-- InternalsVisibleTo has two rules in this repo.

             TEST grants: each exists because a build with it removed fails. Audited 2026-08-24 by
             removing every grant in a detached worktree and building each consumer; the one that
             compiled without a grant was deleted. Judge a probe by whether the build SUCCEEDS, never
             by grepping for one error code: an inaccessible STATIC member reads to the compiler as
             an absent one (CS0117, not CS0122).

             PRODUCTION grants: the PDF/A repair machinery (PdfDocumentEditor.Preview*/Repair*, the
             Fonts.Remediation planner, the editor's font-program mutations, XmpConformance's two
             structure repairs) is internal on purpose. Pellucid needs it; the library must not
             publish it (Docs/superpowers/specs/2026-09-06-release-2-6-0-design.md, D2 and D5). These
             grants are the bridge until that code moves into the Pellucid repo, at which point they
             are removed. Widening the public surface is NOT the preferred fix for a CS0122 from a
             Pellucid assembly; one more grant is. -->

        <!-- Test grants. -->
        <!-- Needs PdfDictionary, PdfInteger, PdfName, PdfStream. -->
        <InternalsVisibleTo Include="PdfLibrary.Rendering.Wpf.Tests" />
        <!-- Both need exactly two types: EmbeddedFontMetrics and PdfFontDescriptor. -->
        <InternalsVisibleTo Include="PdfLibrary.Tests" />
        <InternalsVisibleTo Include="PdfLibrary.Integration" />
        <!-- Needs the internal static PdfImageToCmyk.StencilInkFromFill (G-14 Task 7 render pins). -->
        <InternalsVisibleTo Include="Pellucid.Rendering.Avalonia.Tests" />

        <!-- Production grants (2.6.0): the repair surface. -->
        <InternalsVisibleTo Include="Pellucid.Core" />
        <InternalsVisibleTo Include="Pellucid.App" />
        <InternalsVisibleTo Include="Pellucid.Remediation" />
        <InternalsVisibleTo Include="Pellucid.Core.Tests" />
        <InternalsVisibleTo Include="Pellucid.App.Tests" />
        <InternalsVisibleTo Include="Pellucid.Remediation.Tests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Serilog" />
      <PackageReference Include="Serilog.Sinks.File" />
      <PackageReference Include="Wacton.Unicolour" />
      <!-- Transitive runtime dependencies of the bundled internal DLLs (FontParser needs
           System.Text.Json; Logging needs Serilog.Sinks.Console). These must be declared
           here because the project references below use PrivateAssets=all, which otherwise
           suppresses their transitive package dependencies from this package. (FontParser's
           Microsoft.CSharp dependency is provided by the net10.0 shared framework, so it is
           intentionally not re-declared here.) -->
      <PackageReference Include="Serilog.Sinks.Console" />
      <PackageReference Include="System.Text.Json" />
    </ItemGroup>

    <ItemGroup>
      <!-- PrivateAssets=all: these internal libraries are bundled INTO this package
           (CopyProjectReferencesToPackage target) rather than referenced as separate
           NuGet packages, so they must NOT be emitted as package dependencies. -->
      <ProjectReference Include="..\ICCSharp\ICCSharp.csproj" PrivateAssets="all" />
      <ProjectReference Include="..\Xmp\Xmp.csproj" PrivateAssets="all" />
      <ProjectReference Include="..\ImageLibrary\JpegCodec\JpegCodec.csproj" PrivateAssets="all" />
      <ProjectReference Include="..\ImageLibrary\PixelResampler\PixelResampler.csproj" PrivateAssets="all" />
      <ProjectReference Include="..\FontParser\FontParser.csproj" PrivateAssets="all" />
      <ProjectReference Include="..\ImageLibrary\LzwCodec\LzwCodec.csproj" PrivateAssets="all" />
      <ProjectReference Include="..\Logging\Logging.csproj" PrivateAssets="all" />
      <ProjectReference Include="..\ImageLibrary\Jbig2Decoder\Jbig2Decoder.csproj" PrivateAssets="all" />
      <ProjectReference Include="..\ImageLibrary\Jp2Codec\Jp2Codec.csproj" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Fixups\" />
    </ItemGroup>

    <!-- Bundle the internal project-reference assemblies into lib/<tfm> so the package is
         self-contained. The set is the full local closure of PdfLibrary's project references,
         including CcittCodec (a transitive reference via Jbig2Decoder). If a new internal
         project is added to the reference graph, add its DLL here. -->
    <Target Name="CopyProjectReferencesToPackage">
        <ItemGroup>
            <BuildOutputInPackage Include="$(OutputPath)ICCSharp.dll" />
            <BuildOutputInPackage Include="$(OutputPath)JpegCodec.dll" />
            <BuildOutputInPackage Include="$(OutputPath)PixelResampler.dll" />
            <BuildOutputInPackage Include="$(OutputPath)FontParser.dll" />
            <BuildOutputInPackage Include="$(OutputPath)LzwCodec.dll" />
            <BuildOutputInPackage Include="$(OutputPath)Logging.dll" />
            <BuildOutputInPackage Include="$(OutputPath)Jbig2Decoder.dll" />
            <BuildOutputInPackage Include="$(OutputPath)Jp2Codec.dll" />
            <BuildOutputInPackage Include="$(OutputPath)CcittCodec.dll" />
            <BuildOutputInPackage Include="$(OutputPath)PdfLibrary.Xmp.dll" />
            <!-- Xmp.csproj generates its own XML docs (public XmpPacket/XmpProperty/XmpSchemas/
                 XmpValueKind/XmpField/etc. moved out of PdfLibrary.dll, so their docs no longer ship
                 inside PdfLibrary.xml); bundle it alongside the DLL so consumers keep IntelliSense. -->
            <BuildOutputInPackage Include="$(OutputPath)PdfLibrary.Xmp.xml" />
        </ItemGroup>
    </Target>

    <!-- The C# compiler writes doc comments for EVERY documented member into the .xml file, internal ones
         included; 2.5.2 shipped the doc text of 86 internal rule types that way. This filters the XML that
         pack picks up (obj copy) and the one CopyProjectReferencesToPackage bundles for Xmp (bin copy) down
         to the public surface. Release-only so Debug builds by project reference (Pellucid) keep IntelliSense
         for the granted internals. Mechanism: tools/DocFilter, a dependency-free console tool; an inline
         RoslynCodeTaskFactory task cannot reference System.Reflection.Metadata (prototyped 2026-09-06).
         The publish workflow asserts the packed result; see Docs/Releasing.md. -->
    <Target Name="StripNonPublicDocs" BeforeTargets="GenerateNuspec" Condition="'$(Configuration)' == 'Release'">
        <ItemGroup>
            <_DocXmlToStrip Include="$(MSBuildProjectDirectory)/bin/$(Configuration)/*/PdfLibrary.xml" />
            <_DocXmlToStrip Include="$(MSBuildProjectDirectory)/obj/$(Configuration)/*/PdfLibrary.xml" />
            <_DocXmlToStrip Include="$(MSBuildProjectDirectory)/bin/$(Configuration)/*/PdfLibrary.Xmp.xml" />
        </ItemGroup>
        <Error Condition="'@(_DocXmlToStrip)' == ''" Text="StripNonPublicDocs: no Release XML documentation files found under bin/ or obj/. Build Release before packing." />
        <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)../tools/DocFilter/DocFilter.csproj&quot; -c Release -- @(_DocXmlToStrip->'&quot;%(RootDir)%(Directory)%(Filename).dll&quot; &quot;%(FullPath)&quot;', ' ')" />
    </Target>

</Project>
