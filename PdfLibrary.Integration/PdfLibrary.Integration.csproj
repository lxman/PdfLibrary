<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\PdfLibrary\PdfLibrary.csproj" />
      <ProjectReference Include="..\PdfLibrary.Rendering.Svg\PdfLibrary.Rendering.Svg.csproj" />
      <!-- Direct reference: FontDiagnostic.cs uses FontParser types directly. PdfLibrary now
           bundles FontParser privately (PrivateAssets=all) so it no longer flows transitively. -->
      <ProjectReference Include="..\FontParser\FontParser.csproj" />
    </ItemGroup>

    <PropertyGroup>
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

</Project>
