<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.0.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageReference Include="xunit.v3" Version="3.2.2"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- Native assets for cross-platform CI testing -->
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.150.1" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PdfLibrary\PdfLibrary.csproj"/>
        <!-- XmpPacket/XmpProperty/XmpSchemas/XmpValueKind now live in the Xmp assembly; PdfLibrary's
             reference to it is PrivateAssets="all" so it does not flow transitively to this project,
             and the type forwarders in PdfLibrary only resolve at runtime, not compile time. -->
        <ProjectReference Include="..\Xmp\Xmp.csproj"/>
        <ProjectReference Include="..\PdfLibrary.Rendering.SkiaSharp\PdfLibrary.Rendering.SkiaSharp.csproj"/>
        <ProjectReference Include="..\PdfLibrary.Rendering.Svg\PdfLibrary.Rendering.Svg.csproj"/>
        <ProjectReference Include="..\PdfLibrary.Integration\PdfLibrary.Integration.csproj" />
        <!-- Direct references: these tests use FontParser.Reader (BigEndianReaderTests) and
             JpegCodec (DctDecodeCmykTests) types directly. PdfLibrary now bundles them
             privately (PrivateAssets=all), so they no longer flow transitively. -->
        <ProjectReference Include="..\FontParser\FontParser.csproj" />
        <ProjectReference Include="..\ImageLibrary\JpegCodec\JpegCodec.csproj" />
        <ProjectReference Include="..\ICCSharp\ICCSharp.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Shared test source, not a project reference: the CFF charset fixtures are needed both by the
             parser-level tests in FontParser.Tests and by the EmbeddedFontMetrics-level tests here, and
             linking one file is cheaper than making two test projects depend on each other. -->
        <Compile Include="..\FontParser.Tests\Cff\MinimalCff.cs" Link="Fonts\Embedded\MinimalCff.cs" />
    </ItemGroup>

    <ItemGroup>
        <!-- CC0 public-domain test font (see Resources/PublicPixel.LICENSE.txt) used by the
             PdfDocumentBuilder.LoadFont(byte[]/Stream) overload tests. -->
        <None Update="Resources\PublicPixel.ttf" CopyToOutputDirectory="PreserveNewest" />
        <None Update="Resources\PublicPixel.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
        <!-- Known-conformant PDF/A-2b reference doc from the veraPDF corpus (CC BY 4.0;
             see Resources/conformant-pdfa2b.LICENSE.txt) — the "clean document" fixture. -->
        <None Update="Resources\conformant-pdfa2b.pdf" CopyToOutputDirectory="PreserveNewest" />
        <None Update="Resources\conformant-pdfa2b.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
        <!-- Official ZUGFeRD 2.5 / Factur-X example invoice (FeRD license; see
             Resources/MINIMUM_Rechnung_fx.LICENSE.txt) — real PDF/A-3 embedded-files fixture. -->
        <None Update="Resources\MINIMUM_Rechnung_fx.pdf" CopyToOutputDirectory="PreserveNewest" />
        <None Update="Resources\MINIMUM_Rechnung_fx.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
        <!-- veraPDF verdict snapshot (the parity "answer key"; regenerate via
             tools/verapdf-parity/capture.sh). Copied next to the test binary so the parity
             loader and gates read it without the corpus or any JVM present. -->
        <None Update="Conformance\parity\verapdf-verdicts.json" CopyToOutputDirectory="PreserveNewest" />
        <!-- Liberation 2.1.5 faces (OFL-1.1; see Resources/Liberation/LICENSE-Liberation.txt), test-only.
             Fed to BundledStandard14Provider so the embed round-trip gates resolve the same
             TrueType/glyf face on every machine instead of whatever the OS ships for Helvetica/Times/
             Courier. These must never appear in PdfLibrary.csproj — the engine ships none. -->
        <None Update="Resources\Liberation\*.ttf" CopyToOutputDirectory="PreserveNewest" />
        <None Update="Resources\Liberation\LICENSE-Liberation.txt" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>