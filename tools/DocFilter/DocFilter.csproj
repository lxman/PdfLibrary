<Project Sdk="Microsoft.NET.Sdk">
  <!-- Filters a C# XML documentation file down to the assembly's public surface. Run at pack time by the
       StripNonPublicDocs target in PdfLibrary/PdfLibrary.csproj; unit-tested from PdfLibrary.Tests. No
       package dependencies on purpose: System.Reflection.Metadata is in-box. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>PdfLibrary.Build</RootNamespace>
    <AssemblyName>DocFilter</AssemblyName>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
