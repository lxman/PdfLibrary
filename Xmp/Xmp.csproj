<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>PdfLibrary.Xmp</AssemblyName>
    <RootNamespace>PdfLibrary</RootNamespace>

    <!-- This assembly carries public API (XmpPacket/XmpProperty/XmpSchemas/XmpValueKind, forwarded
         from PdfLibrary; plus XmpField and the SetStruct/SetStructArray surface this branch adds).
         In 2.5.2 those types' docs shipped inside PdfLibrary.xml because the types lived directly in
         PdfLibrary.dll; now that they live here, this project must generate its own XML doc file so
         consumers keep IntelliSense. See PdfLibrary.csproj's CopyProjectReferencesToPackage target,
         which must bundle PdfLibrary.Xmp.xml alongside PdfLibrary.Xmp.dll. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- The public surface is a checked-in file (Docs/superpowers/specs/2026-09-06-release-2-6-0-design.md, D9).
         RS0016: a public symbol is missing from PublicAPI.*.txt. RS0017: the file names a symbol that no
         longer exists. Both are errors: adding public API is a reviewed text-file diff, never an accident.
         RS0026/RS0027 (overload-shape rules) are suppressed: they would require changing shipped
         signatures, and the API files are the contract. -->
        <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
        <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- XmpNode/XmpTreeParser/XmpDate are internal to this assembly; PdfLibrary's conformance
         rules and the test project consume them directly. -->
    <InternalsVisibleTo Include="PdfLibrary" />
    <InternalsVisibleTo Include="PdfLibrary.Tests" />
  </ItemGroup>

</Project>
